# Cloudflare Pages response headers, read natively at deploy time.

# Content-Security-Policy — every page's scripts are external files, so
# script-src needs no 'unsafe-inline'. Third party, and why each host is here:
#   static.cloudflareinsights.com  Cloudflare Web Analytics beacon script
#   cloudflareinsights.com     beacon reports (connect-src)
# style-src has no 'unsafe-inline': our own CSS is all in /css/.
# The analytics beacon stays dormant until configured (js/analytics.js), but
# the policy already allows it so switching it on needs no header change.
# e2e/csp.spec.js enforces this policy in the browser.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# JS and CSS under /js/ and /css/ deliberately get no long-lived cache rule:
# their filenames aren't content-hashed, so a long max-age would keep
# returning visitors on stale scripts after a deploy while the HTML moved on.
# Pages' default (max-age=0, must-revalidate + ETag) keeps them correct and
# still serves a 304 when nothing changed.

/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400
